[Unit]
Description=Claude Code Remote Control for the Atelier observer
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=simple
WorkingDirectory=/home/felix-hummert/git/atelier
Environment=HOME=/home/felix-hummert
Environment=PATH=/home/felix-hummert/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/felix-hummert/.local/bin/claude remote-control --name "Atelier Observer" --spawn session --sandbox
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
