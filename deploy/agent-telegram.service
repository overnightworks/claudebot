[Unit]
Description=Private Telegram bridge for Claude Code and Codex CLI
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=6

[Service]
Type=simple
WorkingDirectory=%h/git/claudebot
EnvironmentFile=%h/.secrets/claudebot.env
EnvironmentFile=%h/.secrets/claudebot-runtime.env
Environment=PYTHONUNBUFFERED=1
# The project is not installed into the virtualenv (pyproject: package =
# false), so the package directory reaches the interpreter through the path.
Environment=PYTHONPATH=%h/git/claudebot/src
ExecStart=%h/git/claudebot/.venv/bin/python -m claudebot.telegram_bot
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
